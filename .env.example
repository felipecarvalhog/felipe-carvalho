# =============================================================================
# felipe-carvalho-hudi-pages — exemplo de variáveis de ambiente
# Copie este arquivo para `.env.local` e ajuste os valores.
# NUNCA coloque segredos reais neste arquivo (ele é versionado).
# Apenas variáveis com prefixo NEXT_PUBLIC_ chegam ao bundle do navegador.
# =============================================================================

# URL canônica do site. Usada em metadata, Open Graph, sitemap e robots.
# Em produção, use a URL pública real (ex.: https://felipecarvalho.exemplo.com.br).
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# Modo de revisão: "true" exibe marcadores explícitos de itens pendentes
# (foto, contatos, prazos, aviso de emergência) e o banner de envio simulado.
# NUNCA habilite em produção.
NEXT_PUBLIC_REVIEW_MODE=true

# Adaptador de destino da lista de espera: "mock" | "webhook".
# mock    = nada é persistido; a resposta é explicitamente marcada como simulada.
# webhook = envia um POST JSON para WAITLIST_WEBHOOK_URL (somente no servidor).
WAITLIST_ADAPTER=mock

# URL do webhook que receberá os dados da lista de espera.
# Somente servidor (sem prefixo NEXT_PUBLIC_). Obrigatória quando WAITLIST_ADAPTER=webhook.
WAITLIST_WEBHOOK_URL=

# Token bearer opcional enviado no header Authorization do webhook.
# Somente servidor. Deixe vazio se o destino não exigir autenticação.
WAITLIST_WEBHOOK_TOKEN=

# Rate limit em memória do endpoint /api/waitlist: máximo de envios por IP na janela.
WAITLIST_RATE_LIMIT_MAX=5

# Tamanho da janela do rate limit, em milissegundos (600000 = 10 minutos).
WAITLIST_RATE_LIMIT_WINDOW_MS=600000
